{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/codex/hook.js\" session-start",
            "timeout": 15,
            "additionalContextLimit": 6000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/codex/hook.js\" user-prompt-submit",
            "timeout": 15,
            "additionalContextLimit": 16000
          }
        ]
      }
    ]
  }
}
