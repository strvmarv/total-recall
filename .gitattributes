dist/** linguist-generated
*.onnx filter=lfs diff=lfs merge=lfs -text
tests/fixtures/lfs-pointer-model.onnx -filter -diff -merge text
# Generated by `dump-catalog`; the Linux CI drift guard regenerates and diffs it.
# Pin to LF so the committed file matches CI output regardless of contributor autocrlf.
catalog.json text eol=lf

# Codex: codex/mcp.json embeds codex/bootstrap.cjs byte-for-byte (generated by codex/build-mcp.js); pin both to LF.
codex/mcp.json text eol=lf
codex/bootstrap.cjs text eol=lf

# The develop profile lists shell commands that the skill runs; pin it to LF so none of them carries a carriage return.
.github/develop.md text eol=lf
