[
  {
    "name": "markdown link is flattened to its text",
    "input": "Fixed [the cache](https://x.y) bug\n",
    "expected": "Fixed the cache bug"
  },
  {
    "name": "link text may span a line break",
    "input": "[two\nlines](https://x.y)",
    "expected": "two lines"
  },
  {
    "name": "nested links are flattened until none is left (inner link inside a link text)",
    "input": "[[a](b)](c)",
    "expected": "a"
  },
  {
    "name": "nested links are flattened until none is left (link inside longer link text)",
    "input": "[a [b](u)](v)",
    "expected": "a b"
  },
  {
    "name": "a URL containing a closing parenthesis ends at the first one",
    "input": "[a](https://x/y_(z)) tail",
    "expected": "a) tail"
  },
  {
    "name": "an angle-bracketed URL that leaves a link behind is flattened again",
    "input": "<http://[a]>(b)",
    "expected": "http://a"
  },
  {
    "name": "the link pass runs before the angle-bracket pass (an angle-bracketed URL inside a link target)",
    "input": "[a](<https://x)>)",
    "expected": "a>)"
  },
  {
    "name": "the link pass runs before the angle-bracket pass (a link closes inside an open angle bracket)",
    "input": "<https://x[a](b>)",
    "expected": "<https://xa"
  },
  {
    "name": "doubled angle brackets lose both pairs",
    "input": "<<https://x.y>>",
    "expected": "https://x.y"
  },
  {
    "name": "an unclosed link is left alone",
    "input": "see [a](http://x now",
    "expected": "see [a](http://x now"
  },
  {
    "name": "a link is flattened before the length cut",
    "input": "[word](https://example.com/pppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppp) tail",
    "expected": "word tail"
  },
  {
    "name": "ANSI escape sequences are removed",
    "input": "\u001b[31mred\u001b[0m",
    "expected": "red"
  },
  {
    "name": "an ANSI sequence with several parameters is removed",
    "input": "\u001b[1;31mbold\u001b[0m",
    "expected": "bold"
  },
  {
    "name": "a lone ESC character is removed",
    "input": "a\u001bb",
    "expected": "ab"
  },
  {
    "name": "whitespace runs including newlines and tabs collapse to one space",
    "input": "a\n\nb\tc",
    "expected": "a b c"
  },
  {
    "name": "non-breaking space, line separator and vertical tab are whitespace",
    "input": "a\u00a0b\u2028c\u000bd",
    "expected": "a b c d"
  },
  {
    "name": "control characters are removed",
    "input": "\u0007\u0000",
    "expected": ""
  },
  {
    "name": "angle brackets around a bare http or https URL are dropped",
    "input": "see <https://x.y> now",
    "expected": "see https://x.y now"
  },
  {
    "name": "the scheme match for angle brackets is case-insensitive",
    "input": "<HTTPS://X.Y>",
    "expected": "HTTPS://X.Y"
  },
  {
    "name": "angle brackets around other schemes are kept",
    "input": "<mailto:a@b.c>",
    "expected": "<mailto:a@b.c>"
  },
  {
    "name": "inline code and emphasis are kept",
    "input": "keep `code` and *emphasis*",
    "expected": "keep `code` and *emphasis*"
  },
  {
    "name": "surrounding whitespace is trimmed",
    "input": "  padded  \n",
    "expected": "padded"
  },
  {
    "name": "a byte order mark is not whitespace and is kept",
    "input": "\ufeffabc",
    "expected": "\ufeffabc"
  },
  {
    "name": "empty input stays empty",
    "input": "",
    "expected": ""
  },
  {
    "name": "text of exactly 200 characters is kept",
    "input": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "expected": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  },
  {
    "name": "a space at index 200 gives exactly 200 characters",
    "input": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb cccc",
    "expected": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
  },
  {
    "name": "long text is cut at the last space at or before 200 characters, with no ellipsis",
    "input": "abcdefghij abcdefghij abcdefghij abcdefghij abcdefghij abcdefghij abcdefghij abcdefghij abcdefghij abcdefghij abcdefghij abcdefghij abcdefghij abcdefghij abcdefghij abcdefghij abcdefghij abcdefghij abcdefghij abcdefghij abcdefghij abcdefghij abcdefghij",
    "expected": "abcdefghij abcdefghij abcdefghij abcdefghij abcdefghij abcdefghij abcdefghij abcdefghij abcdefghij abcdefghij abcdefghij abcdefghij abcdefghij abcdefghij abcdefghij abcdefghij abcdefghij abcdefghij"
  },
  {
    "name": "a short word followed by a very long word keeps only the short word",
    "input": "short ",
    "expected": "short"
  },
  {
    "name": "a single word longer than 200 characters is cut at 200",
    "input": "",
    "expected": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  },
  {
    "name": "a cut never leaves half of a surrogate pair",
    "input": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\ud83d\ude00zzz",
    "expected": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  },
  {
    "name": "an unpaired surrogate in the input is passed through, not repaired",
    "input": "a \ud83d ",
    "expected": "a \ud83d"
  },
  {
    "name": "the angle-bracket scheme match is ASCII-only (U+017F does not fold to s)",
    "input": "<http\u017f://x>",
    "expected": "<http\u017f://x>"
  }
]
