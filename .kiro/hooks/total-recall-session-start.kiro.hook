{
  "enabled": true,
  "name": "total-recall Session Start",
  "version": "1",
  "description": "Initializes the total-recall memory system at session start",
  "when": {
    "type": "sessionStart"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Call the total-recall `session_start` MCP tool now, before anything else. This loads your pinned directives, hot-tier memories, and knowledge base context for this session. After it returns, briefly announce: tier counts from tierSummary, storage backend, and any hints. Keep it to 2-3 lines. Do not ask the user anything — just initialize and report."
  },
  "shortName": "total-recall-session-start"
}
