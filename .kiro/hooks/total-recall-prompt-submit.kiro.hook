{
  "enabled": true,
  "name": "total-recall Retrieve",
  "version": "1",
  "description": "Reminds the agent to search memory before answering questions or starting tasks",
  "when": {
    "type": "promptSubmit"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Before answering the user's message: if it is a question, task, or involves project context — call `memory_search` with the user's message as the query (warm tier). Use the results to inform your answer. Do NOT search for pure greetings, one-word replies, or messages that are only asking you to run a command. Say nothing to the user about this check."
  },
  "shortName": "total-recall-retrieve"
}
